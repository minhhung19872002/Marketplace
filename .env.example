# ===== ShopHub — biến môi trường (sao chép thành .env rồi sửa) =====
# Mọi biến có tiền tố SH_. Không commit tệp .env thật.

# --- CSDL PostgreSQL ---
SH_DB_HOST=postgres
SH_DB_PORT=5432
SH_DB_NAME=shophub
SH_DB_USER=shophub
# Đổi mật khẩu này trước khi chạy thật
SH_DB_PASSWORD=change-me-db

# --- Redis (khoá có tiền tố sh:) ---
SH_REDIS_URL=redis:6379

# --- MinIO (S3) ---
SH_MINIO_ENDPOINT=minio:9000
SH_MINIO_ACCESS_KEY=shophub
# Tối thiểu 8 ký tự
SH_MINIO_SECRET_KEY=change-me-minio

# --- Meilisearch ---
SH_MEILI_URL=http://meilisearch:7700
# Khoá chủ, tối thiểu 16 byte
SH_MEILI_MASTER_KEY=change-me-meili-master-key

# --- JWT ---
# Chuỗi bí mật ≥ 32 ký tự, sinh ngẫu nhiên
SH_JWT_SECRET=change-me-to-a-long-random-secret-string

# --- Thư điện tử (mặc định: Mailpit bắt thư khi dev) ---
SH_SMTP_HOST=mailpit
SH_SMTP_PORT=1025

# --- Cổng mở ra máy chủ (chỉ 127.0.0.1) ---
SH_HTTP_PORT=18000

# --- SMS (simulated = ghi vào bảng sys.simulated_sms, xem ở /api/dev/sms khi Development) ---
SH_SMS_PROVIDER=simulated

# --- Thư gửi đi ---
SH_SMTP_FROM=ShopHub <no-reply@shophub.local>

# --- Dữ liệu mẫu (tài khoản, …). Đặt false cho CSDL production sạch ---
SH_SEED_SAMPLE=true

# --- Giới hạn tốc độ theo IP (lần/phút). Mặc định trong mã: 20 / 10; stack dev đặt 300 ---
SH_RATE_LIMIT_AUTH=300
SH_RATE_LIMIT_OTP=300
# Trần chung mọi yêu cầu / IP / phút (mặc định trong mã: 600)
SH_RATE_LIMIT_GLOBAL=5000
# Cổng thanh toán giả lập (SimulatedGateway): chỉ bật cho môi trường demo/kiểm thử, TẮT ở production
SH_PAYMENT_SIMULATED=true

# --- Dải proxy được tin để đọc X-Forwarded-For (CIDR, phân cách dấu phẩy) ---
SH_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Khoá mã hoá cột nhạy cảm (số tài khoản, CCCD): 32 byte base64. KHÔNG đổi sau khi đã có dữ liệu ---
SH_DATA_KEY=change-me-base64-32-bytes (openssl rand -base64 32)

# --- URL trình duyệt dùng để tải ảnh/tệp (gateway /s3 → MinIO) ---
SH_MEDIA_PUBLIC_URL=http://localhost:18000/s3

